              "   pm.test(\"Status is 200\", () => pm.response.to.have.status(200));\n   pm.test(\"Status body is ok\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));"
            ]
          }
        }
      ],
      "request": {
