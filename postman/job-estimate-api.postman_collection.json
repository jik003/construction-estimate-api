{
  "info": {
    "_postman_id": "1a370331-f5b0-4de1-8030-ac72ca3d2b01",
    "name": "Job Estimate API",
    "description": "API tests for the Job Estimate & Management API: customer CRUD flow with chained requests and response validation. Select the `local` environment and run the Customers folder.\n\n[Learn more about Postman Collections.](https://learning.postman.com/docs/collections/collections-overview/)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Customers",
      "item": [
        {
          "name": "Create customer",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set(\"customer_name\", \"Postman Test \" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();\n\npm.test(\"Status is 201\", () => {\n    pm.response.to.have.status(201);\n});\n\npm.test(\"Name matches what we sent\", () => {\n    pm.expect(body.name).to.eql(pm.variables.get(\"customer_name\"));\n});\n\npm.test(\"Server assigned a numeric id\", () => {\n    pm.expect(body.id).to.be.a(\"number\");\n});\n\npm.environment.set(\"customer_id\", body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "   {\n     \"name\": \"{{customer_name}}\",\n     \"phone\": \"010-1234-5678\",\n     \"address\": \"123 Main St\"\n   }",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/customers",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "customers"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));\npm.test(\"Returns the created customer\", () => {\n    pm.expect(pm.response.json().id).to.eql(Number(pm.environment.get(\"customer_id\")));\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/customers/{{customer_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "customers",
                "{{customer_id}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "List customers",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));\npm.test(\"List contains the created customer\", () => {\n    const ids = pm.response.json().map(c => c.id);\n    pm.expect(ids).to.include(Number(pm.environment.get(\"customer_id\")));\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/customers",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "customers"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Update customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();\npm.test(\"Status is 200\", () => pm.response.to.have.status(200));\npm.test(\"Address changed\", () => pm.expect(body.address).to.eql(\"456 Updated Ave\"));\npm.test(\"Other fields unchanged\", () => pm.expect(body.phone).to.eql(\"010-1234-5678\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{ \"address\": \"456 Updated Ave\" }",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/customers/{{customer_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "customers",
                "{{customer_id}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Delete customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/customers/{{customer_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "customers",
                "{{customer_id}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get deleted customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Deleted customer returns 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/customers/{{customer_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "customers",
                "{{customer_id}}"
              ]
            }
          },
          "response": []
        }
      ]
    },
